# Copie este arquivo para ".env" e preencha com sua chave.
# NUNCA suba o arquivo ".env" (com a chave de verdade) para o GitHub.

# Chave da API da Anthropic (paga por uso, crédito pré-pago).
# Como conseguir: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Modelo e nível de esforço do Claude (fixos para os resultados do TCC
# serem reproduzíveis). O Sonnet 5.5 não aceita ajuste de temperatura.
MODELO_CLAUDE=claude-sonnet-5-5
ESFORCO_CLAUDE=low

# Abordagem de extração usada no fluxo final ("tesseract" ou "multimodal"),
# definida a partir do resultado da comparação (ver README).
EXTRATOR_IMAGEM=multimodal

# Limiares da checagem de qualidade da foto (ajuste após testar com as
# fotos reais; ver app/extraction/qualidade_imagem.py).
# QUALIDADE_LIMIAR_NITIDEZ=25
# QUALIDADE_BRILHO_MINIMO=50
# QUALIDADE_CONTRASTE_MINIMO=60
# QUALIDADE_LADO_MINIMO_PX=300
